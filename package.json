{
  "name": "hermes-agent-for-vscode",
  "displayName": "Hermes Agent for VS Code",
  "description": "Native VS Code interface for the Hermes Agent CLI (Nous Research) over ACP — chat, tools, diffs, approvals, plans, sessions and the full CLI.",
  "version": "0.1.3",
  "publisher": "Danil0ws",
  "license": "MIT",
  "icon": "media/icon.png",
  "author": {
    "name": "Danilo Rodrigues",
    "email": "mydanilows@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Danil0ws/hermes-agent-for-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/Danil0ws/hermes-agent-for-vscode/issues"
  },
  "homepage": "https://github.com/Danil0ws/hermes-agent-for-vscode#readme",
  "engines": {
    "vscode": "^1.100.0",
    "node": ">=18"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "keywords": [
    "hermes",
    "acp",
    "agent",
    "ai",
    "nous",
    "chat"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hermes",
          "title": "%viewContainer.hermes.title%",
          "icon": "media/hermes-agent-for-vscode.svg"
        }
      ]
    },
    "views": {
      "hermes": [
        {
          "id": "hermes.chat",
          "name": "%view.chat.name%",
          "type": "webview"
        },
        {
          "id": "hermes.sessions",
          "name": "%view.sessions.name%",
          "type": "tree"
        },
        {
          "id": "hermes.plan",
          "name": "%view.plan.name%",
          "type": "webview",
          "visibility": "collapsed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "hermes.chat",
        "contents": "%viewsWelcome.chat.contents%"
      }
    ],
    "commands": [
      {
        "command": "hermes.newConversation",
        "title": "%command.hermes.newConversation.title%",
        "category": "Hermes",
        "icon": "$(add)"
      },
      {
        "command": "hermes.worktree.new",
        "title": "%command.hermes.worktree.new.title%",
        "category": "Hermes",
        "icon": "$(git-branch)"
      },
      {
        "command": "hermes.showSessions",
        "title": "%command.hermes.showSessions.title%",
        "category": "Hermes",
        "icon": "$(history)"
      },
      {
        "command": "hermes.openInEditor",
        "title": "%command.hermes.openInEditor.title%",
        "category": "Hermes",
        "icon": "$(open-preview)"
      },
      {
        "command": "hermes.manage",
        "title": "%command.hermes.manage.title%",
        "category": "Hermes",
        "icon": "$(gear)"
      },
      {
        "command": "hermes.openCli",
        "title": "%command.hermes.openCli.title%",
        "category": "Hermes"
      },
      {
        "command": "hermes.runCliCommand",
        "title": "%command.hermes.runCliCommand.title%",
        "category": "Hermes"
      },
      {
        "command": "hermes.diagnostics",
        "title": "%command.hermes.diagnostics.title%",
        "category": "Hermes"
      },
      {
        "command": "hermes.showLog",
        "title": "%command.hermes.showLog.title%",
        "category": "Hermes"
      },
      {
        "command": "hermes.showTraffic",
        "title": "%command.hermes.showTraffic.title%",
        "category": "Hermes"
      },
      {
        "command": "hermes.exportConversation",
        "title": "%command.hermes.exportConversation.title%",
        "category": "Hermes"
      },
      {
        "command": "hermes.askAboutSelection",
        "title": "%command.hermes.askAboutSelection.title%",
        "category": "Hermes"
      },
      {
        "command": "hermes.explainSelection",
        "title": "%command.hermes.explainSelection.title%",
        "category": "Hermes"
      },
      {
        "command": "hermes.fixProblem",
        "title": "%command.hermes.fixProblem.title%",
        "category": "Hermes"
      },
      {
        "command": "hermes.sendFileToHermes",
        "title": "%command.hermes.sendFileToHermes.title%",
        "category": "Hermes"
      },
      {
        "command": "hermes.restartSession",
        "title": "%command.hermes.restartSession.title%",
        "category": "Hermes",
        "icon": "$(debug-restart)"
      },
      {
        "command": "hermes.showPlan",
        "title": "%command.hermes.showPlan.title%",
        "category": "Hermes"
      },
      {
        "command": "hermes.showContext",
        "title": "%command.hermes.showContext.title%",
        "category": "Hermes"
      },
      {
        "command": "hermes.plan.implement",
        "title": "%command.hermes.plan.implement.title%",
        "category": "Hermes"
      },
      {
        "command": "hermes.context.manage",
        "title": "%command.hermes.context.manage.title%",
        "category": "Hermes"
      },
      {
        "command": "hermes.agents.test",
        "title": "%command.hermes.agents.test.title%",
        "category": "Hermes"
      },
      {
        "command": "hermes.mcp.add",
        "title": "%command.hermes.mcp.add.title%",
        "category": "Hermes"
      },
      {
        "command": "hermes.skill.open",
        "title": "%command.hermes.skill.open.title%",
        "category": "Hermes"
      },
      {
        "command": "hermes.instructions.open",
        "title": "%command.hermes.instructions.open.title%",
        "category": "Hermes"
      },
      {
        "command": "hermes.approvals.open",
        "title": "%command.hermes.approvals.open.title%",
        "category": "Hermes"
      },
      {
        "command": "hermes.queue.toggle",
        "title": "%command.hermes.queue.toggle.title%",
        "category": "Hermes"
      },
      {
        "command": "hermes.keepFile",
        "title": "%command.hermes.keepFile.title%",
        "category": "Hermes"
      },
      {
        "command": "hermes.undoFile",
        "title": "%command.hermes.undoFile.title%",
        "category": "Hermes"
      },
      {
        "command": "hermes.copyResponse",
        "title": "%command.hermes.copyResponse.title%",
        "category": "Hermes"
      },
      {
        "command": "hermes.sessions.open",
        "title": "%command.hermes.sessions.open.title%",
        "category": "Hermes"
      },
      {
        "command": "hermes.sessions.rename",
        "title": "%command.hermes.sessions.rename.title%",
        "category": "Hermes"
      },
      {
        "command": "hermes.sessions.fork",
        "title": "%command.hermes.sessions.fork.title%",
        "category": "Hermes"
      },
      {
        "command": "hermes.sessions.archive",
        "title": "%command.hermes.sessions.archive.title%",
        "category": "Hermes"
      },
      {
        "command": "hermes.sessions.delete",
        "title": "%command.hermes.sessions.delete.title%",
        "category": "Hermes"
      },
      {
        "command": "hermes.sessions.copyId",
        "title": "%command.hermes.sessions.copyId.title%",
        "category": "Hermes"
      },
      {
        "command": "hermes.context.add",
        "title": "%command.hermes.context.add.title%",
        "category": "Hermes"
      },
      {
        "command": "hermes.context.remove",
        "title": "%command.hermes.context.remove.title%",
        "category": "Hermes"
      },
      {
        "command": "hermes.context.toggleImplicit",
        "title": "%command.hermes.context.toggleImplicit.title%",
        "category": "Hermes"
      },
      {
        "command": "hermes.setupCli",
        "title": "%command.hermes.setupCli.title%",
        "category": "Hermes"
      },
      {
        "command": "hermes.permissions.toggleYolo",
        "title": "%command.hermes.permissions.toggleYolo.title%",
        "category": "Hermes"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "hermes.newConversation",
          "when": "view == hermes.chat",
          "group": "navigation@1"
        },
        {
          "command": "hermes.showSessions",
          "when": "view == hermes.chat",
          "group": "navigation@2"
        },
        {
          "command": "hermes.restartSession",
          "when": "view == hermes.chat && hermes.sessionActive",
          "group": "navigation@3"
        },
        {
          "command": "hermes.openInEditor",
          "when": "view == hermes.chat",
          "group": "1_open@1"
        },
        {
          "command": "hermes.manage",
          "when": "view == hermes.chat",
          "group": "navigation@4"
        },
        {
          "command": "hermes.worktree.new",
          "when": "view == hermes.chat",
          "group": "navigation@5"
        },
        {
          "command": "hermes.openCli",
          "when": "view == hermes.chat",
          "group": "2_advanced@1"
        },
        {
          "command": "hermes.runCliCommand",
          "when": "view == hermes.chat",
          "group": "2_advanced@2"
        },
        {
          "command": "hermes.diagnostics",
          "when": "view == hermes.chat",
          "group": "2_advanced@3"
        },
        {
          "command": "hermes.showLog",
          "when": "view == hermes.chat",
          "group": "2_advanced@4"
        },
        {
          "command": "hermes.showTraffic",
          "when": "view == hermes.chat",
          "group": "2_advanced@5"
        },
        {
          "command": "hermes.exportConversation",
          "when": "view == hermes.chat",
          "group": "2_advanced@6"
        },
        {
          "command": "hermes.showPlan",
          "when": "view == hermes.plan"
        },
        {
          "command": "hermes.showContext",
          "when": "view == hermes.sessions",
          "group": "navigation@1"
        }
      ],
      "editor/context": [
        {
          "command": "hermes.askAboutSelection",
          "when": "editorHasSelection",
          "group": "hermes@1"
        },
        {
          "command": "hermes.explainSelection",
          "when": "editorHasSelection",
          "group": "hermes@2"
        },
        {
          "command": "hermes.sendFileToHermes",
          "group": "hermes@3"
        }
      ],
      "explorer/context": [
        {
          "command": "hermes.sendFileToHermes",
          "group": "hermes@1"
        }
      ],
      "commandPalette": [
        {
          "command": "hermes.showPlan",
          "when": "false"
        },
        {
          "command": "hermes.fixProblem",
          "when": "false"
        }
      ],
      "view/item/inline": [
        {
          "command": "hermes.sessions.rename",
          "when": "view == hermes.sessions && viewItem == hermes.session",
          "group": "inline@1"
        },
        {
          "command": "hermes.sessions.fork",
          "when": "view == hermes.sessions && viewItem == hermes.session",
          "group": "inline@2"
        }
      ],
      "view/item/context": [
        {
          "command": "hermes.sessions.open",
          "when": "view == hermes.sessions && viewItem == hermes.session",
          "group": "1_open@1"
        },
        {
          "command": "hermes.sessions.copyId",
          "when": "view == hermes.sessions && viewItem == hermes.session",
          "group": "1_open@2"
        },
        {
          "command": "hermes.sessions.archive",
          "when": "view == hermes.sessions && viewItem == hermes.session",
          "group": "9_danger@1"
        },
        {
          "command": "hermes.sessions.delete",
          "when": "view == hermes.sessions && viewItem == hermes.session",
          "group": "9_danger@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "hermes.newConversation",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n"
      },
      {
        "command": "hermes.askAboutSelection",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a",
        "when": "editorHasSelection"
      }
    ],
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "hermes.cliPath": {
          "type": "string",
          "default": "hermes",
          "scope": "machine-overridable",
          "description": "%config.hermes.cliPath.description%"
        },
        "hermes.agents": {
          "type": "object",
          "default": {
            "Hermes": {
              "command": "hermes",
              "args": [
                "acp"
              ],
              "profile": "",
              "cwd": "",
              "env": {}
            }
          },
          "scope": "machine-overridable",
          "description": "%config.hermes.agents.description%"
        },
        "hermes.defaultAgent": {
          "type": "string",
          "default": "Hermes",
          "description": "%config.hermes.defaultAgent.description%",
          "scope": "machine-overridable"
        },
        "hermes.defaultWorkingDirectory": {
          "type": "string",
          "default": "",
          "description": "%config.hermes.defaultWorkingDirectory.description%",
          "scope": "machine-overridable"
        },
        "hermes.skipConfiguredMcp": {
          "type": "boolean",
          "default": true,
          "scope": "machine-overridable",
          "description": "%config.hermes.skipConfiguredMcp.description%"
        },
        "hermes.permissions": {
          "type": "string",
          "enum": [
            "ask",
            "allowSession",
            "allowAll"
          ],
          "default": "ask",
          "enumDescriptions": [
            "%config.hermes.permissions.enum.ask%",
            "%config.hermes.permissions.enum.allowSession%",
            "%config.hermes.permissions.enum.allowAll%"
          ],
          "description": "%config.hermes.permissions.description%"
        },
        "hermes.showReasoning": {
          "type": "string",
          "enum": [
            "always",
            "collapsed",
            "hidden"
          ],
          "default": "collapsed",
          "description": "%config.hermes.showReasoning.description%"
        },
        "hermes.queue.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.hermes.queue.enabled.description%"
        },
        "hermes.queue.defaultAction": {
          "type": "string",
          "enum": [
            "queue",
            "steer"
          ],
          "default": "queue",
          "description": "%config.hermes.queue.defaultAction.description%"
        },
        "hermes.context.warnAt": {
          "type": "number",
          "default": 80,
          "minimum": 10,
          "maximum": 99,
          "description": "%config.hermes.context.warnAt.description%"
        },
        "hermes.notifications": {
          "type": "string",
          "enum": [
            "off",
            "windowNotFocused",
            "always"
          ],
          "default": "windowNotFocused",
          "description": "%config.hermes.notifications.description%"
        },
        "hermes.logTraffic": {
          "type": "boolean",
          "default": false,
          "description": "%config.hermes.logTraffic.description%"
        },
        "hermes.worktreeRoot": {
          "type": "string",
          "default": "",
          "description": "%config.hermes.worktreeRoot.description%"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p tsconfig.json --noEmit",
    "build:extension": "node scripts/build-extension.mjs",
    "build:webview": "vite build",
    "clean": "rm -rf dist dist-test",
    "build": "npm run compile && npm run clean && npm run build:extension && npm run build:webview",
    "watch": "node scripts/build-extension.mjs --watch",
    "test": "node scripts/build-tests.mjs && node --test dist-test/*.mjs",
    "package": "npm run build && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "^0.21.1",
    "@preact/preset-vite": "^2.10.1",
    "@preact/signals": "^2.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.100.0",
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.25.0",
    "preact": "^10.25.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
